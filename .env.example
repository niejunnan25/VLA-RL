# VLA-RL local path template.
#
# Copy this file to .env, edit the paths for your machine, and source it before
# launching long-running LIBERO residual SAC experiments:
#
#   set -a
#   source .env
#   set +a

# ---------------------------------------------------------------------------
# OpenPI base policy service
# ---------------------------------------------------------------------------

OPENPI_ROOT=/path/to/openpi-modified
OPENPI_CONDA_ENV=openpi-modified
POLICY_CONFIG=pi0_libero_baseline_10_bs32_150000
POLICY_DIR=/path/to/openpi-assets/serl_torch_ckpt/pi0_10000

# ---------------------------------------------------------------------------
# LIBERO simulator and datasets
# ---------------------------------------------------------------------------

LIBERO_ROOT=/path/to/LIBERO
LIBERO_DATASETS_ROOT=/path/to/libero/datasets

# The reward-model adapters need a demonstration/goal dataset. For LIBERO this
# is usually the lerobot-converted LIBERO dataset used to fetch final-frame goal
# images.
REWARD_GOAL_DATASET=/path/to/libero_lerobot

# ---------------------------------------------------------------------------
# Robo-Dopamine reward model
# ---------------------------------------------------------------------------

REWARD_MODEL_REPO=/path/to/Robo-Dopamine
REWARD_MODEL_CONDA_ENV=/path/to/envs/robo-dopamine
REWARD_MODEL_PATH=/path/to/Robo-Dopamine-GRM-2.0-4B-Preview
ROBODOPAMINE_ROOT=/path/to/Robo-Dopamine

# Optional vLLM/backend knobs used by the Robo-Dopamine service.
VLLM_ATTENTION_BACKEND=TORCH_SDPA

# ---------------------------------------------------------------------------
# RoboMeter reward model
# ---------------------------------------------------------------------------

ROBOMETER_ROOT=/path/to/robometer
ROBOMETER_MODEL_PATH=/path/to/Robometer-4B
ROBOMETER_BACKEND=native
ROBOMETER_PYTHON_CMD=/path/to/robometer/.venv/bin/python

# RoboMeter benchmark/eval helpers. These are only needed by RoboMeter tools,
# but keeping them here makes the stack explicit.
ROBOMETER_PROCESSED_DATASETS_PATH=/path/to/robometer_processed_datasets
ROBOMETER_SENTENCE_MODEL_PATH=/path/to/sentence-transformers/all-MiniLM-L12-v2

# ---------------------------------------------------------------------------
# Hugging Face / cache mirrors
# ---------------------------------------------------------------------------

HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/path/to/hf_cache
HF_HUB_CACHE=/path/to/hf_cache/hub
